* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', 'Kadwa', serif;
    line-height: 1.8;
    color: #333;
    background-color: rgb(255, 233, 233);
}

.header {
    font-family: 'Poppins', 'Kadwa', serif;
    font-weight: 500;
    font-size: 1.2rem;
    background-color: #7C0A02;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed;
    top: 0;
    width: 100%;
    height: 70px;  /* Adjust height as needed */
    z-index: 1000;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);  /* Adds shadow */
}

.header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.logo {
    padding: 0.1rem;
    border-radius: 20%;
    width: 90px;
    height: 90px;
}

.school-name {
    font-size: 25px;
    font-weight: regular;
    font-family: 'poppins', 'sans-serif';
    color: #fff;
}

.header-right {
    display: flex;
    align-items: center;
}

.menu-header {
    background-color: #4e0404;
    color: white;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav {
    display: flex;
    align-items: center;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 2rem;
}

nav ul li {
    padding: 0.5rem;
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    transition: color 0.3s ease;
}

nav ul li a:hover {
    color: #F1D915;
}

/* Add an active state for the current page */
nav ul li a.active {
    color: #F1D915;
    border-bottom: 2px solid #F1D915;
}


.footer {
  position: relative;
  background-color: #1e1e1e;
  color: white;
  font-family: 'Segoe UI', sans-serif;
}

.footer-bottom {
  text-align: bottom;
  padding: 20px;
  background-color: rgba(87, 49, 49, 0.509);
  position: relative;
  z-index: 2;
  font-size: 14px;
  color: #ccc;
}



