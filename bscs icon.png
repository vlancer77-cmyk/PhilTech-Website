<!DOCTYPE html>
<html lang="en">
<style>
@import url('https://fonts.googleapis.com/css2?family=Kadwa:wght@400;700&family=Poppins:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');
</style>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PhilTech-GMA</title>
    <link rel="stylesheet" href="Faculty & Staff.css">
    <link rel="stylesheet" href="dev-info-style.css">
</head>
<body>
    <header class="header">
        <div class="header-left">
            <img src="logo w.out name.png" alt="PhilTech Logo" class="logo">
            <h1 class="school-name">PhilTech-GMA</h1>
        </div>
        <nav>
            <ul>
                <li><a href="philtech_home.html">Home</a></li>
                <li><a href="Faculty & Staff.html">Faculty & Staff</a></li>
                <li><a href="Admissions.html">Admissions</a></li>
                <li><a href="College.html">College</a></li>
                <li><a href="Contact.html">Contact</a></li>
            </ul>
        </nav>
        
    </header>

    <main>
        <section class="welcome-banner">
            <div class="banner-content">
                <h2>Philippine Technological Institute of Science Arts and Trade</h2>
                <p class="school-quote">"Global Success Through Academic Excellence"</p>
                <a href="enrollment form.html" class="enroll-btn">Enroll Now</a>
            </div>
        </section>

        <section class="Faculty-Staff"> 
            <h2>Faculty & Staff</h2>
            <div class="faculty-grid">
                <!-- Row 1 -->
                <div class="faculty-card">
                    <img src="mr. ephraim.jpg" alt="Teacher Ephraim" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Mr. Ephraim Cabande</h3>
                        <p>English Teacher</p>
                    </div>
                </div>

                <div class="faculty-card">
                    <img src="mr. francis.jpg" alt="Teacher Francis" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Mr. Francis Jun Patalen</h3>
                        <p>Programming Teacher</p>
                    </div>
                </div>

                <div class="faculty-card">
                    <img src="mr. gerald.jpg" alt="Teacher Gerald" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Mr. Gerald Ello</h3>
                        <p>Research Teacher</p>
                    </div>
                </div>

                <div class="faculty-card">
                    <img src="mr. jude.jpg" alt="Teacher Jude" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Mr. Jude Rodriguez</h3>
                        <p>Mathematics Teacher</p>
                    </div>
                </div>

                <!-- Row 2 -->
                <div class="faculty-card">
                    <img src="mr. michael.jpg" alt="Teacher Michael" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Mr. Michael Atienza</h3>
                        <p>N.S.T.P. and P.E. Teacher</p>
                    </div>
                </div>

                <div class="faculty-card">
                    <img src="mr. nori.jpg" alt="Teacher Nori" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Mr. Nori Lacerna</h3>
                        <p>History Teacher</p>
                    </div>
                </div>

                <div class="faculty-card">
                    <img src="mr. raiven.jpg" alt="Teacher Raiven" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Mr. Raiven Gordon</h3>
                        <p>CSS and VGD Teacher</p>
                    </div>
                </div>

                <div class="faculty-card">
                    <img src="mr. raniel.jpg" alt="Teacher Raniel" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Mr. Raniel Gordon</h3>
                        <p>Home Economics Teacher</p>
                    </div>
                </div>

                <!-- Row 3 -->
                <div class="faculty-card">
                    <img src="ms. edith.jpg" alt="Teacher Edith" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Ms. Edith Yabut</h3>
                        <p>Filipino Teacher</p>
                    </div>
                </div>

                <div class="faculty-card">
                    <img src="ms. grace.jpg" alt="Teacher Grace" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Ms. Grace Rivera</h3>
                        <p>Purposive Communication Teacher</p>
                    </div>
                </div>

                <div class="faculty-card">
                    <img src="ms. joy.jpg" alt="Teacher Joy" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Ms. Joy Magno</h3>
                        <p>Home Economics Teacher</p>
                    </div>
                </div>

                <div class="faculty-card">
                    <img src="ms. kim.jpg" alt="Teacher Kim" class="faculty-img">
                    <div class="faculty-text">
                        <h3>Ms. Kim Acerna</h3>
                        <p>PhilTech and Life Spirit Teacher</p>
                    </div>
                </div>
            </div>
        </section>
    </main>


</body>

<footer class="footer">
  <div class="footer-banner">
    <img src="banner.jpg" alt="Campus Banner" class="footer-banner-img" />

    <div class="footer-content">
      <div class="footer-left">
        <img src="logo w.out name.png" class="footer-logo" alt="PhilTech Logo" />
        <h2>PhilTech-GMA</h2>
        <p>Philippine Technological Institute of Science Arts and Trade Inc.</p>
        <h3>CRDM Governor's Drive, Brgy. Maderan<br>Gen. Mariano Alvarez, Cavite 4117, Philippines</h3>
        <h4>Main Campus</h4>
        <p>Tanay, Rizal</p>
      </div>

      <div class="footer-right">
        <div class="highlight-text">
          <p>years of proven</p>
          <h1>14</h1>
          <h2>Quality</h2>
          <h3>Education</h3>
        </div>

        </div>
        <div class="contact-info">
          <div class="icon-line">
            <img src="ig icon.png" class="social-icon" alt="Instagram" />
            <p>Philtech GMA</p>
          </div>
          <div class="icon-line">
            <img src="phone icon.png" class="social-icon" alt="Phone" />
            <p>(+63) 997-224-0222</p>
          </div>
          <div class="icon-line">
            <img src="fb icon.png" class="social-icon" alt="Facebook" />
            <p>PhilTech-GMA</p>
          </div>
          <div class="icon-line">
            <img src="email icon.png" class="social-icon" alt="Email" />
            <p>philtech.edu01@gmail.com</p>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; Copyright 2025. All Rights Reserved | PhilTech - GMA</p>
    </div>
  </div>
</footer>
<div class="floating-dev-icon" id="devToggle">
  👤
</div>

<div class="floating-dev-info" id="devInfo">
  <h4>Chris Thiego G. Baghari</h4>
  <p>Email: christhiegobaghari@gmail.com</p>
  <p>Phone: 0994-246-1783</p>
  <div class="social-links">
    <a href="https://www.facebook.com/share/1J3adQnzSb/" target="_blank" class="fb" title="Facebook">f</a>
    <a href="https://www.instagram.com/apzillia?igsh=bjRsajI2cXd0OXc=" target="_blank" class="ig" title="Instagram">i</a>
  </div>
</div>
<script>
  const devIcon = document.getElementById('devToggle');
  const devInfo = document.getElementById('devInfo');

  devIcon.addEventListener('click', () => {
    devInfo.style.display = devInfo.style.display === 'block' ? 'none' : 'block';
  });

  // Close when clicking outside
  document.addEventListener('click', function(event) {
    if (!devIcon.contains(event.target) && !devInfo.contains(event.target)) {
      devInfo.style.display = 'none';
    }
  });
</script>
</body>
</html>
